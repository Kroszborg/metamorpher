# Metamorpher environment variables. Copy to .env.local for local overrides
# (never commit real values). Every variable is optional: without a database the
# site is the static tool site, with accounts and statistics switched off.

# --- Site -----------------------------------------------------------------------
# Public origin for canonical URLs and the sitemap. On Vercel the production
# domain is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=https://metamorpher.example

# --- Backend master switch ------------------------------------------------------
# Accounts, history sync, usage statistics and /admin are OFF unless this is 1.
# Leave it unset to deploy the tool site on its own.
ENABLE_BACKEND=

# --- Database (Neon Postgres) ---------------------------------------------------
# Pooled or direct Neon connection string. Without it: development uses an
# embedded PGlite database in .data/ (gitignored); production switches accounts
# and statistics off (account pages say so, the API answers 503).
# NOTE: this is read at build time too (it decides whether the account button
# is shown), so redeploy after adding or removing it.
DATABASE_URL=postgres://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Accounts (Better Auth) -----------------------------------------------------
# Required in production for accounts: a long random string used to sign
# cookies and tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin used in email links and for the CSRF origin check. Defaults to
# NEXT_PUBLIC_SITE_URL (or the Vercel production domain).
BETTER_AUTH_URL=

# Comma-separated emails that may open /admin. Everyone else gets a 404.
ADMIN_EMAILS=you@example.com

# --- Email (SMTP, e.g. Gmail) ---------------------------------------------------
# A Gmail address plus an app password (Google Account > Security > 2-Step
# Verification > App passwords). Host and port default to smtp.gmail.com:465.
# EMAIL_FROM defaults to "Metamorpher <SMTP_USER>". Takes priority over Resend.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Email (Resend) -------------------------------------------------------------
# With both set, sign-up requires email confirmation and password reset works.
# Without them: in development links are printed to the server console; in
# production sign-up works without confirmation and password reset is hidden
# (the admin System page shows a warning).
RESEND_API_KEY=
EMAIL_FROM="Metamorpher <no-reply@metamorpher.example>"

# --- Analytics ------------------------------------------------------------------
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/rollup (daily rollup and cleanup, see vercel.json).
CRON_SECRET=
# Set to 1 to switch first-party usage statistics off entirely.
ANALYTICS_DISABLED=
